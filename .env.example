# SpendLens — copy to .env.local and fill values. Never commit .env.local.

# === Supabase (audit + lead persistence) ===
# Project URL — from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Anon key — public, RLS-enforced, used in browser for /r/[id] reads
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS for inserts. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# === Anthropic (AI summary) ===
# Your API key from console.anthropic.com
ANTHROPIC_API_KEY=

# === Resend (transactional email) ===
RESEND_API_KEY=
# Verified sender — must match a domain you've verified in Resend
RESEND_FROM_EMAIL=audit@yourdomain.com
# Where Credex sales notifications go for high-savings cases
CREDEX_NOTIFY_EMAIL=hello@credex.rocks

# === Upstash Redis (IP rate limit) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === App ===
# Public canonical URL — used in OG tags + share URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
